{
  "name": "resume-studio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Backend Control Layer for Resume Studio: identity, entitlements, usage metering, billing, and Bedrock model routing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test --import ./test/setup.mjs test/*.test.mjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-secrets-manager": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2"
  }
}
