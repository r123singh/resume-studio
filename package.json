{
  "name": "resume-studio",
  "version": "1.0.0",
  "description": "Cursor-like AI editor for resume tailoring",
  "main": "dist-electron/main.js",
  "author": "Resume Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pack:dir": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir",
    "pack:portable": "npm run build && node scripts/pack-portable.mjs",
    "pack:zip": "node scripts/make-zip.mjs",
    "pack:release": "npm run build && node scripts/pack-portable.mjs && node scripts/make-zip.mjs",
    "electron:build": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "smoke:agent": "node scripts/smoke-agent.mjs",
    "smoke:evidence": "node scripts/smoke-evidence-apply.mjs",
    "aws:bootstrap": "node scripts/aws-bootstrap.mjs",
    "aws:verify": "node scripts/aws-verify.mjs",
    "backend:install": "npm --prefix backend install",
    "backend:test": "npm --prefix backend test",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:deploy": "node scripts/deploy-backend.mjs"
  },
  "build": {
    "appId": "com.resumestudio.app",
    "productName": "Resume Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@strands-agents/**",
      "node_modules/@aws-sdk/**",
      "node_modules/@smithy/**",
      "node_modules/@anthropic-ai/**",
      "node_modules/@google/**",
      "node_modules/openai/**",
      "node_modules/zod/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Resume-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resume Studio"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@aws-sdk/client-sts": "^3.1113.0",
    "@aws-sdk/credential-provider-ini": "^3.973.14",
    "@cursor/sdk": "^1.0.26",
    "@google/genai": "^2.16.0",
    "@monaco-editor/react": "^4.7.0",
    "@strands-agents/sdk": "^1.12.0",
    "lucide-react": "^1.31.0",
    "marked": "^15.0.7",
    "monaco-editor": "^0.52.2",
    "openai": "^6.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
